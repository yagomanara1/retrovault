{
  "name": "retrovault",
  "productName": "RetroVault",
  "version": "0.1.3",
  "description": "Launcher estilo Steam para ROMs (RetroArch) e executáveis, com conquistas do RetroAchievements.",
  "main": "./out/main/index.js",
  "author": "Yago Manara",
  "homepage": "https://github.com/yagomanara1/retrovault",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs watch",
    "catalog:repo": "node scripts/catalog-repo.mjs",
    "icon": "node scripts/icon.mjs",
    "release:check": "node scripts/release-check.mjs",
    "package": "npm run test && npm run build && electron-builder --win --dir",
    "dist": "npm run test && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.retrovault.app",
    "productName": "RetroVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RetroVault",
      "artifactName": "RetroVault-Setup-${version}.${ext}",
      "uninstallDisplayName": "RetroVault",
      "deleteAppDataOnUninstall": false,
      "language": "1046",
      "multiLanguageInstaller": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yagomanara1",
        "repo": "retrovault",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller@5.4.0": true
  }
}
